{
  "version": "1.0.0",
  "description": "24 routes × 2 typical failure cases; read-only diagnostics, never executes experiments",
  "families": {
    "SCIENTIFIC": {
      "class": "science",
      "check": "重建主假设、最相近论文及反证条件；确认是科学前提失败还是证据不足",
      "fix": "缩窄主张或修改研究问题；不能只换名或堆架构",
      "verify": "新命题可证伪且有可信真值/基线；重大改题须用户选择"
    },
    "SOURCES": {
      "class": "evidence",
      "check": "逐条对原文 DOI/代码/原始数据核对事实、年份及近邻贡献",
      "fix": "更正引文或降级未验证断言；只增量查关键来源",
      "verify": "关键文献/限制均可定位，未知保留UNKNOWN"
    },
    "DATA": {
      "class": "science",
      "check": "核对数据许可、来源、标签定义、独立性、时间、身份/分组",
      "fix": "修复许可/数据/合法分组；若仅代理标签，收窄代理主张",
      "verify": "新数据/标签/划分经独立检查，旧污染指标标INVALID"
    },
    "LEAKAGE": {
      "class": "invalid",
      "check": "审计重复对象、未来时间、train-only预处理、val/test选模访问记录",
      "fix": "暂停所有确认性优势声明；修正划分与因果处理，保留失效证据",
      "verify": "仅在未污染的合法确认数据上验证；不得反复重冻同一test"
    },
    "BASELINE": {
      "class": "science",
      "check": "核对强基线/简单基线的输入、horizon、预处理、容量、调参预算",
      "fix": "补公平对照，取消不公平的获益声明",
      "verify": "同样数据/预算下可重现全种子效果和不确定性"
    },
    "ENGINEERING": {
      "class": "engineering",
      "check": "最小复现堆栈、张量/单位/种子/最近diff、回归失败样例",
      "fix": "先写/运行失败回归测试，再一次只修一个根因；普通工程范围内可继续",
      "verify": "原错误复现消失且相关回归测试通过；不能以代码PASS替代科学PASS"
    },
    "TRAINING": {
      "class": "engineering",
      "check": "NaN/OOM/梯度/学习率、标签尺度、可否过拟合极小训练集、资源记录",
      "fix": "先做静态和小batch诊断，按已获授权调整单一因素，不无限换网络",
      "verify": "故障根因可解释，原合法val复验并记录全部尝试"
    },
    "PROTOCOL": {
      "class": "invalid",
      "check": "比较数据/协议/模型/评价脚本 SHA 和正式测试使用史",
      "fix": "标记受影响结果INVALID；修改冻结需新用户批准；确认测试被用来调参则另寻独立确认数据",
      "verify": "合法冻结和新结果可追溯；不能沿用失效结论"
    },
    "EVIDENCE": {
      "class": "science",
      "check": "区分探索/确认、独立样本单位、CI、seed、负对照和真正改进效应",
      "fix": "科学结论降级为HOLD/INCONCLUSIVE或做一次针对性实验",
      "verify": "贡献与统计证据一致，否定结果完整保留"
    },
    "REVIEW": {
      "class": "review",
      "check": "核对独立审查者身份、原始源码/指标/数据访问和结果差异",
      "fix": "无独立者写INDEPENDENT_REVIEW_UNAVAILABLE；仅对关键问题定向复核",
      "verify": "独立复核有真实来源或明确NOT_REPRODUCED"
    },
    "WRITING": {
      "class": "claim",
      "check": "逐项对应论文/图/答复的Claim、Run、指标、数据版本和原始记录",
      "fix": "修正文稿或图表、限定主张；不得编造训练和外部提交",
      "verify": "所有结论与证据一致、局限保留"
    },
    "AUTH": {
      "class": "permission",
      "check": "查真实用户新消息的操作范围、预算/时间上限与停止条件",
      "fix": "停止受限动作，只继续获批CPU/静态范围；展示清晰授权申请",
      "verify": "有实际明确批准和剩余预算才执行GPU/付费/正式/发布"
    }
  },
